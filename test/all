#!/usr/bin/env bash
# Every test orchard has. Needs Qt6's qmltestrunner; no display required.
set -uo pipefail
cd "$(dirname "$0")/.."

export QT_QPA_PLATFORM=offscreen QML_XHR_ALLOW_FILE_READ=1
# The desktop session may export a platform theme plugin intended for normal
# GUI applications. Headless qmltestrunner must not load it: a plugin crash
# here takes down the runner before any test can report a useful failure.
unset QT_QPA_PLATFORMTHEME

# This suite imports Qt 6 modules. Arch can have both runners installed and
# /usr/bin/qmltestrunner may resolve to Qt 5, so prefer Qt 6 explicitly.
runner=/usr/lib/qt6/bin/qmltestrunner
[ -x "$runner" ] || { echo "Qt 6 qmltestrunner not found at $runner"; exit 127; }

status=0

# Build the optional Rust alert command when a Rust toolchain is installed.
# Source installs without Cargo continue through the Python fallback tests.
if [ -f helper/native/Cargo.toml ] && command -v cargo >/dev/null 2>&1; then
  printf '\n== helper/native (Cargo)\n'
  if ! ./helper/build-native; then
    echo "native helper build failed"
    status=1
  fi
else
  echo "Skipping native helper build (Cargo or helper/native/Cargo.toml unavailable)"
fi

for suite in tests/tst_*.qml; do
  printf '\n== %s\n' "$suite"
  output=$("$runner" -input "$suite" 2>&1)
  runner_status=$?
  grep -E 'FAIL|Totals' <<<"$output"
  grep -q 'FAIL' <<<"$output" && status=1
  if [ "$runner_status" -ne 0 ]; then
    echo "qmltestrunner exited with status $runner_status"
    status=1
  fi
done

# The helper's own suite, offline.
printf '\n== tests/helper\n'
output=$(python3 -B -m unittest discover -s tests/helper -p 'test_*.py' 2>&1 | grep -v g_uri_join)
tail -n 1 <<<"$output"
grep -qE '^OK' <<<"$(tail -n 1 <<<"$output")" || { echo "$output"; status=1; }

# Checks on the QML source itself that the QML engine does not make.
printf '\n== tests/lint\n'
output=$(python3 -B -m unittest discover -s tests/lint -p 'test_*.py' 2>&1)
tail -n 1 <<<"$output"
grep -qE '^OK' <<<"$(tail -n 1 <<<"$output")" || { echo "$output"; status=1; }

printf '\n'
[ $status -eq 0 ] && echo "all suites passed" || echo "FAILURES"
exit $status
